rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ─────────────────────────────────────────────────────────────────────────
     * 1. USERS COLLECTION & ALL SUBCOLLECTIONS
     *    Covers:
     *      users/{userId}                    → user profile document
     *      users/{userId}/scanned_fabrics/   → fabric scan results
     *      users/{userId}/generated_designs/ → AI-generated design sketches
     *
     *    Rule: only the authenticated owner of that userId can access their data.
     * ─────────────────────────────────────────────────────────────────────────
     */
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Wildcard covers every subcollection (scanned_fabrics, generated_designs, etc.)
      match /{document=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    /**
     * ─────────────────────────────────────────────────────────────────────────
     * 2. FABRIC LIBRARY (Global / shared collection)
     *    Documents must contain a userId field equal to the caller's UID.
     * ─────────────────────────────────────────────────────────────────────────
     */
    match /fabric_library/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if request.auth != null
                                  && resource.data.userId == request.auth.uid;
    }

    /**
     * ─────────────────────────────────────────────────────────────────────────
     * 3. APP SETTINGS
     *    - All authenticated users can READ (needed to fetch API key + credits).
     *    - All authenticated users can UPDATE / SET (needed for the Stability AI
     *      balance sync that writes image_credits back to app_settings/system).
     *    - CREATE and DELETE are blocked (admin-only via Firebase Console).
     * ─────────────────────────────────────────────────────────────────────────
     */
    match /app_settings/{docId} {
      allow read:             if request.auth != null;
      allow update:           if request.auth != null;
      allow create, delete:   if false;
    }

    /**
     * ─────────────────────────────────────────────────────────────────────────
     * 4. GLOBAL FALLBACK — deny everything not matched above
     *    Prevents any other collection from being accidentally accessible.
     * ─────────────────────────────────────────────────────────────────────────
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
