rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /**
     * ─────────────────────────────────────────────────────────────────────────
     * 1. USER FABRIC UPLOADS
     *    Path used by the app: users/{userId}/fabrics/{fileName}
     * ─────────────────────────────────────────────────────────────────────────
     */
    match /users/{userId}/fabrics/{fileName} {
      allow read:  if request.auth != null
                   && request.auth.uid == userId;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    /**
     * ─────────────────────────────────────────────────────────────────────────
     * 2. USER AI DESIGN / SKETCH UPLOADS
     * ─────────────────────────────────────────────────────────────────────────
     */
    match /users/{userId}/designs/{fileName} {
      allow read:  if request.auth != null
                   && request.auth.uid == userId;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    /**
     * ─────────────────────────────────────────────────────────────────────────
     * 3. USER PROFILE PICTURES
     *    Path used by profile_page.dart: user_profiles/{userId}/{fileName}
     * ─────────────────────────────────────────────────────────────────────────
     */
    match /user_profiles/{userId}/{fileName} {
      allow read:  if request.auth != null; // Everyone can see profiles
      
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024 // 5 MB max for profiles
                   && request.resource.contentType.matches('image/.*');
    }

    /**
     * ─────────────────────────────────────────────────────────────────────────
     * 4. GLOBAL FALLBACK — deny everything else
     * ─────────────────────────────────────────────────────────────────────────
     */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
